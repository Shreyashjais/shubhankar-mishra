# Your production domain (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional: make the contact form send real emails through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@your-domain.com
CONTACT_FROM_EMAIL="Website <onboarding@resend.dev>"
